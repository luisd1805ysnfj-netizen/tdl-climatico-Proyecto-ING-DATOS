# Server-side secret for the Vercel/Netlify TollGuru proxy; never prefix with VITE_.
TOLLGURU_API_KEY=
# Optional HTTPS endpoint that returns licensed source metadata and current market data at /prices.
VITE_MARKET_PRICES_API=
# Optional HTTPS endpoint that returns cited crop temperature/humidity ranges at /requirements.
VITE_CROP_REQUIREMENTS_API=
# Only set this for a GitHub Pages project site, e.g. /my-repository/
VITE_BASE_PATH=/
